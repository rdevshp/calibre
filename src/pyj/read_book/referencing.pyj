from __python__ import bound_methods, hash_literals

from read_book.flow_mode import flow_spine_section_for_name, has_flow_spine_sections
from read_book.globals import current_layout_mode, current_spine_item


def current_reference_root():
    if current_layout_mode() is 'flow' and has_flow_spine_sections():
        return flow_spine_section_for_name(current_spine_item().name) or document
    return document

def elem_for_ref(refnum):
    refnum = int(refnum)
    return current_reference_root().getElementsByTagName('p')[refnum - 1]


def start_reference_mode():
    si = current_spine_item().index
    for i, p in enumerate(current_reference_root().getElementsByTagName('p')):
        p.dataset.calibreRefNum = f'{si}.{i + 1}'
    document.body.classList.add('calibre-reference-mode')


def end_reference_mode():
    document.body.classList.remove('calibre-reference-mode')
